<%- layout("/layouts/boilerplate") %>

<!-- TITLE -->
<div class="container mt-3">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">
      <h3 class="show-list-h3"><b><%= listing.title %></b></h3>
    </div>
  </div>
</div>

<!-- LISTING CARD -->
<div class="container mt-3">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">
      <div class="card list-card">
        <img 
          src="<%= listing.image.url %>" 
          class="card-img-top show-img img-fluid"
          alt="listing_img"
        >

        <div class="card-body">
          <p class="card-text">
            Owned by: <i><%= listing.owner.username %></i><br>
            <%= listing.description %><br>
            <b>&#8377;<%= listing.price.toLocaleString("en-IN") %>/night</b><br>
            <%= listing.location %><br>
            <%= listing.country %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- EDIT / DELETE -->
<% if(userCurr && userCurr._id.equals(listing.owner._id)){ %>
<div class="container mt-3">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 d-flex gap-3">
      <form method="get" action="/listings/<%= listing._id %>/edit">
        <button class="btn edit-btn">Edit</button>
      </form>
      <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
  </div>
</div>
<% } %>

<hr>

<!-- LEAVE REVIEW -->
<% if(userCurr){ %>
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">
      <h4>Leave a Review</h4>

      <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
        <input type="hidden" name="review[rating]" id="ratingInput" required>

        <div class="star-rating mb-2">
          <span class="star" data-value="1">&#9733;</span>
          <span class="star" data-value="2">&#9733;</span>
          <span class="star" data-value="3">&#9733;</span>
          <span class="star" data-value="4">&#9733;</span>
          <span class="star" data-value="5">&#9733;</span>
        </div>

        <label class="form-label">Comments</label>
        <textarea name="review[comment]" class="form-control" rows="4" required></textarea>

        <button class="btn btn-outline-dark mt-3">Submit</button>
      </form>
    </div>
  </div>
</div>
<% } %>

<hr>

<!-- ALL REVIEWS -->
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">
      <h4>All Reviews</h4>

      <div class="row">
        <% for(let review of listing.reviews){ %>
        <div class="col-12 col-md-6 mb-3">
          <div class="card p-2">
            <h6>@<%= review.author.username %></h6>
            <p><%= review.comment %></p>
            <p><%= review.rating %> Stars</p>

            <% if(userCurr && userCurr._id.equals(review.author._id)){ %>
            <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
              <button class="btn btn-sm btn-dark">Delete</button>
            </form>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<hr>

<!-- MAP -->
<div class="container mt-4 mb-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">
      <h3>Where you'll be</h3>
      <div id="map" style="height:300px; width:100%;"></div>
    </div>
  </div>
</div>

<!-- MAP DATA -->
<script>
  const listingGeo = <%- JSON.stringify(listing.geometry) %>;
</script>
<script src="/js/map.js"></script>