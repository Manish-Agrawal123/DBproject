<%- layout("/layouts/boilerplate") %>
<div class="row mt-3">
<div class="col-8 offset-3">
    <h3 class="show-list-h3"><b><%=listing.title%></b></h3>
</div></div>
<div class="card col-6 list-card">
  <img src="<%=listing.image.url%>" class="card-img-top show-img offset-6" alt="listing_img">
  <div class="card-body col-12 offset-6">
    <p class="card-text">
      Owned by:<i><%= listing.owner.username %></i>
        <br>
        <p><%= listing.description %></p>
        <b>&#8377;<%=listing.price.toLocaleString("en-IN")%>/night</b><br>
        <%=listing.location%><br>
        <%=listing.country%>
    </p>
  </div>
</div>
<%if(userCurr && userCurr._id.equals(listing.owner._id)){%>
<div class="btns offset-3 mt-3">
 <form method="get" action="/listings/<%=listing._id%>/edit" ><button class="btn offset-2 edit-btn">Edit</button></form>
    <form method="post" action="/listings/<%=listing._id%>?_method=DELETE" >
        <button class="btn btn-dark offset-4">Delete</button>
</form></div><%}%>
 <hr>
<%if(userCurr){%>
<div class="col-8 offset-3">
  <h4>Leave a Review</h4>
  <form method="post" action="/listings/<%=listing._id%>/reviews" novalidate class="needs-validation">
    <input  type="hidden" name="review[rating]" id="ratingInput" min="1" max="5" required>
    <div class="star-rating">
      <span class="star" data-value="1">&#9733;</span>
      <span class="star" data-value="2">&#9733;</span>
      <span class="star" data-value="3">&#9733;</span>
      <span class="star" data-value="4">&#9733;</span>
      <span class="star" data-value="5">&#9733;</span>
    </div>
    <div>
      <label for="comment" class="form-label">Comments</label>
      <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
      <div class="invalid-feedback">
        Please add some comments for reviews
      </div>
    </div><br>
    <button class="btn btn-outline-dark mb-3">Submit</button>
  </form>
  </div>
  <hr>
  <%}%> 
  <div class="col-8 offset-3">
  <div class="row">
  <% for(review of listing.reviews){ %>
    <p><h4>All Reviews</h4></p>
    <div class="card col-5 pt-2 ms-3 mb-3 pb-2 ">
      <div class="card-body">
        <h5 class="card-title">@<%= review.author.username%></h5>
        <p class="card-text"><%=review.comment%></p>
        <p class="card-text"><%=review.rating%>Stars</p>
      </div>
      <%if(userCurr && userCurr._id.equals(review.author._id)){%>
      <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
        <button class="btn btn-sm btn-dark mt-3">Delete</button>
      </form>
      <%}%> 
    </div>
  <%}%>
  <div>
    <h3>Where you'll be</h3>
   <div id="map"></div>
   </div>
  </div>
</div>
<script>
  const listingGeo = <%-JSON.stringify(listing.geometry) %>
</script>
<script src="/js/map.js"></script>

