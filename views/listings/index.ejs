<% layout("/layouts/boilerplate") %>
<style>
  #filters{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter{
    text-align: center;
    margin-right: 1.2rem;
    margin-left: 0.4rem;
    margin-top: 1rem;
    opacity: 0.7;
  }
  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }
  .text-info{
    display: none;
    color: black !important;
  }
  .text-toggle{
    border:1px solid black;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 1rem;
    margin-left: 2rem;
    display: flex;
    align-items: center;
  }
</style>
<button class="btn btn-outline-dark d-lg-none mb-2 btn-filter">
  <i class="fa-solid fa-filter"></i> Filters
</button>

<div id="filters">
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Room</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic cities</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-tractor"></i></div>
    <p>Farm</p>
  </div>
  <div class="filter">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing pools</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-house-chimney-user"></i></div>
    <p>Cabins</p>
  </div>
  <div class="filter">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arstitic</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Dome</p>
  </div>
  <div class="filter">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arstitic</p>
  </div>
  <div class="text-toggle">
    <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
</div>
</div>
</div>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
<%for(let listing of allListing){%>
  <a href="/listings/<%=listing._id%>" class="listing-link">
<div class="card col list-card">
  <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_img" style="height: 17rem;">
  <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text">
      <b><%=listing.title%><br></b>
      &#8377;<%=listing.price.toLocaleString("en-IN")%>/night
      <i class="text-info">&nbsp; &nbsp; +18% GST</i>
    </p>
  </div>
</div>
</a>
<%}%>
</div>
<script>
  let taxSwitch = document.querySelector("#switchCheckDefault");
  taxSwitch.addEventListener("click",()=>{
  let taxInfo = document.querySelectorAll(".text-info");
  for(info of taxInfo){
    if(info.style.display!="inline"){
      info.style.display="inline";
    }else{
      info.style.display="none";
    }
  }
  })
  const toggleBtn = document.querySelector(".btn-filter");
  const filterBox = document.querySelector("#filters");

  toggleBtn.addEventListener("click", () => {
    if (filterBox.style.display === "flex") {
      filterBox.style.display = "none";
    } else {
      filterBox.style.display = "flex";
    }
  });

  // Ensure filters stay visible on large screens
  window.addEventListener("load", () => {
    if (window.innerWidth >= 992) {
      filterBox.style.display = "flex";
    } else {
      filterBox.style.display = "none";
    }
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

